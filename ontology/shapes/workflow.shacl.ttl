wf:Term a sh:NodeShape ;
    rdfs:comment "A term of a bounded context's glossary. Terms are not written by hand: the graph builder derives one from every class, slot, enum and permissible value of the context's domain ontology (ontology/domains/)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The name of the term, exactly as the domain ontology spells it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path wf:id ;
            sh:pattern "^[A-Za-z][A-Za-z0-9_.]*$" ],
        [ sh:description "Whether a Term is a class, a slot, an enum or one value of an enum." ;
            sh:in ( "class" "slot" "enum" "value" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path wf:term_kind ],
        [ sh:datatype xsd:string ;
            sh:description "What a Term means." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path skos:definition ],
        [ sh:datatype xsd:string ;
            sh:description "The bounded context the item belongs to. It selects the glossary its terms are checked against." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path wf:bounded_context ],
        [ sh:description "How sensitive the data a Term names is." ;
            sh:in ( "public" "internal" "confidential" "PII" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path wf:classification ],
        [ sh:datatype xsd:string ;
            sh:description "Other spellings that resolve to a Term." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:description "Names that must not be used for the concept a Term names." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path wf:denied_synonyms ],
        [ sh:description "Concepts in external vocabularies that mean the same as a Term." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path skos:exactMatch ],
        [ sh:description "Concepts in external vocabularies that are close to a Term." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path skos:closeMatch ] ;
    sh:targetClass wf:Term .
