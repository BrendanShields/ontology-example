        [ sh:datatype xsd:string ;
            sh:description "Who made the Decision." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path wf:decided_by ],
        [ sh:datatype xsd:date ;
            sh:description "The day the Decision was made." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path wf:decided_on ],
        [ sh:datatype xsd:string ;
            sh:description "A one-line summary." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path wf:title ],
        [ sh:description "Where the item is in its lifecycle." ;
            sh:in ( "draft" "ready" "in_progress" "done" "superseded" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path wf:status ],
        [ sh:datatype xsd:string ;
            sh:description "The bounded context the item belongs to. It selects the glossary its terms are checked against." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path wf:bounded_context ],
        [ sh:datatype xsd:string ;
            sh:description "The issue this item mirrors in the tracker, if any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path wf:jira_key ;
            sh:pattern "^[A-Z][A-Z0-9]+-\\d+$" ],
        [ sh:datatype xsd:string ;
            sh:description "The identifier of a Record. It is also the name of its file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
