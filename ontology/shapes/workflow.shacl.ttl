wf:WorkItem a sh:NodeShape ;
    rdfs:comment "A Record that people and agents plan, do and track." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type prov:wasRevisionOf wf:blocked_by wf:decided_by wf:decided_on wf:ears_text wf:generated_by_agent wf:implements wf:justification wf:model_id wf:path wf:pr_url wf:proposed_definition wf:proposed_term wf:rationale wf:resolves wf:risk_tier wf:uses_terms wf:verifies ) ;
