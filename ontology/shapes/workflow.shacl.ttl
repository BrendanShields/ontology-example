# GENERATED by `onto gen` from ontology/workflow.yaml. Do not edit: change the source and regenerate.
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wf: <https://bank.example/ontology/workflow/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wf:Change a sh:NodeShape ;
    rdfs:comment "The act of changing the code to resolve Tasks. Usually one pull request." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class wf:Task ;
            sh:description "The Tasks a Change resolves." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path wf:resolves ],
        [ sh:description "The pull request that carries the Change." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path wf:pr_url ],
        [ sh:datatype xsd:string ;
            sh:description "The coding agent that produced the Change, if one did." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path wf:generated_by_agent ],
        [ sh:datatype xsd:string ;
            sh:description "The model that agent ran on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path wf:model_id ],
        [ sh:datatype xsd:string ;
            sh:description "A one-line summary." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path wf:title ],
        [ sh:description "Where the item is in its lifecycle." ;
            sh:in ( "draft" "ready" "in_progress" "done" "superseded" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path wf:status ],
        [ sh:datatype xsd:string ;
            sh:description "The bounded context the item belongs to. It selects the glossary its terms are checked against." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path wf:bounded_context ],
        [ sh:datatype xsd:string ;
            sh:description "The issue this item mirrors in the tracker, if any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path wf:jira_key ;
            sh:pattern "^[A-Z][A-Z0-9]+-\\d+$" ],
        [ sh:datatype xsd:string ;
            sh:description "The identifier of a Record. It is also the name of its file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path wf:id ;
            sh:pattern "^CHG-\\d{4}$" ] ;
    sh:targetClass wf:Change .

wf:Evidence a sh:NodeShape ;
    rdfs:comment "The recorded result of running one Test. Evidence is derived, never written by hand: `onto evidence collect` produces it from a test run." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class wf:Test ;
            sh:description "The Test whose run this Evidence records." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path wf:of_test ],
        [ sh:description "Whether the Test passed." ;
            sh:in ( "pass" "fail" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path wf:result ],
        [ sh:datatype xsd:string ;
            sh:description "The commit that was checked out when the Test ran." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path wf:commit_sha ;
            sh:pattern "^[0-9a-f]{40}$" ],
        [ sh:description "The CI run that produced the Evidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path wf:run_url ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the record was made." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "The identifier of a Record. It is also the name of its file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path wf:id ;
            sh:pattern "^EVD-\\d{4}$" ] ;
    sh:targetClass wf:Evidence .

wf:LoggedDecision a sh:NodeShape ;
    rdfs:comment "One line of an agent's decision log: what it decided while working, why and on what basis. Logged decisions are not files under work/. They are rows of .audit/<work item>.tsv, turned into provenance by `onto prov emit`." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "When the record was made." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "The stage of work a decision was logged in, such as plan, implement or verify." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path wf:phase ],
        [ sh:datatype xsd:string ;
            sh:description "What was decided, in one sentence." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path prov:value ],
        [ sh:datatype xsd:string ;
            sh:description "Why the Decision was made, and what was rejected." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path wf:rationale ],
        [ sh:datatype xsd:string ;
            sh:description "What the decision rests on, such as a file, a command's output or a link." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path wf:basis ],
        [ sh:datatype xsd:string ;
            sh:description "What came of the decision, once known." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path wf:outcome ],
        [ sh:class wf:WorkItem ;
            sh:description "The work item a logged decision was made for." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path wf:concerns ] ;
    sh:targetClass wf:LoggedDecision .

wf:OntologyChangeRequest a sh:NodeShape ;
    rdfs:comment "A proposal to add, rename, redefine or retire a glossary Term. It is the only route by which a domain ontology changes, and a person approves it." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The term the request is about, spelled as it should appear in the glossary." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path wf:proposed_term ],
        [ sh:datatype xsd:string ;
            sh:description "The definition the term should have." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path wf:proposed_definition ],
        [ sh:datatype xsd:string ;
            sh:description "Why the glossary must change, and which requirement needs it." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path wf:justification ],
        [ sh:datatype xsd:string ;
            sh:description "A one-line summary." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path wf:title ],
        [ sh:description "Where the item is in its lifecycle." ;
            sh:in ( "draft" "ready" "in_progress" "done" "superseded" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path wf:status ],
        [ sh:datatype xsd:string ;
            sh:description "The bounded context the item belongs to. It selects the glossary its terms are checked against." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path wf:bounded_context ],
        [ sh:datatype xsd:string ;
            sh:description "The issue this item mirrors in the tracker, if any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path wf:jira_key ;
            sh:pattern "^[A-Z][A-Z0-9]+-\\d+$" ],
        [ sh:datatype xsd:string ;
            sh:description "The identifier of a Record. It is also the name of its file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path wf:id ;
            sh:pattern "^OCR-\\d{4}$" ] ;
    sh:targetClass wf:OntologyChangeRequest .

wf:Record a sh:NodeShape ;
    rdfs:comment "Anything stored as one file under work/ and identified by its id." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type prov:generatedAtTime prov:wasRevisionOf wf:blocked_by wf:bounded_context wf:commit_sha wf:decided_by wf:decided_on wf:ears_text wf:generated_by_agent wf:implements wf:jira_key wf:justification wf:model_id wf:of_test wf:path wf:pr_url wf:proposed_definition wf:proposed_term wf:rationale wf:resolves wf:result wf:risk_tier wf:run_url wf:status wf:title wf:uses_terms wf:verifies ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The identifier of a Record. It is also the name of its file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path wf:id ] ;
    sh:targetClass wf:Record .

wf:Decision a sh:NodeShape ;
    rdfs:comment "A choice that constrains later work, with its rationale. A Decision stays in force until another Decision supersedes it." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Why the Decision was made, and what was rejected." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path wf:rationale ],
        [ sh:class wf:Term ;
