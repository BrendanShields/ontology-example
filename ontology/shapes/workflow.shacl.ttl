            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path wf:uses_terms ],
        [ sh:class wf:Decision ;
            sh:description "The earlier Decision this one replaces." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
