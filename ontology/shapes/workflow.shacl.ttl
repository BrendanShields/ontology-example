wf:Requirement a sh:NodeShape ;
    rdfs:comment "One thing the system must do, written as a single EARS sentence and bound to the glossary terms it is about." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The requirement as one EARS sentence (\"When <trigger>, the <system> shall <response>\"). Glossary terms are written in backticks." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path wf:ears_text ],
        [ sh:class wf:Term ;
            sh:description "The glossary Terms this item is about. Each must exist in the item's bounded context." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path wf:uses_terms ],
        [ sh:description "How much review a change to this Requirement needs." ;
            sh:in ( "low" "medium" "high" "critical" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path wf:risk_tier ],
        [ sh:datatype xsd:string ;
            sh:description "A one-line summary." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path wf:title ],
        [ sh:description "Where the item is in its lifecycle." ;
            sh:in ( "draft" "ready" "in_progress" "done" "superseded" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path wf:status ],
        [ sh:datatype xsd:string ;
            sh:description "The bounded context the item belongs to. It selects the glossary its terms are checked against." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path wf:bounded_context ],
        [ sh:datatype xsd:string ;
            sh:description "The issue this item mirrors in the tracker, if any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path wf:jira_key ;
            sh:pattern "^[A-Z][A-Z0-9]+-\\d+$" ],
        [ sh:datatype xsd:string ;
            sh:description "The identifier of a Record. It is also the name of its file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path wf:id ;
            sh:pattern "^REQ-\\d{4}$" ] ;
    sh:targetClass wf:Requirement .

wf:Task a sh:NodeShape ;
    rdfs:comment "A unit of work that implements one or more Requirements." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class wf:Requirement ;
            sh:description "The Requirements a Task implements." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
