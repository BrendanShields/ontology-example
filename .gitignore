# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
*.egg-info/
dist/

# Derived by the ontology tooling, never committed:
# evidence is recorded by a test run, provenance bundles are built from it in CI.
work/evidence/
prov/*.ttl

# What the Claude Code engine writes into a mod folder when it loads the mod:
# the API types, and a tsconfig.json that extends them
mods/*/.claude-plugin/types/
mods/*/tsconfig.json

.DS_Store
