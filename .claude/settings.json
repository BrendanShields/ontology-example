{
  "permissions": {
    "allow": [
      "Bash(bin/onto *)",
      "Bash(./bin/onto *)"
    ],
    "deny": [
      "Edit(/apps/call-qa-agent/src/call_qa_agent/generated.py)",
      "Edit(/apps/call-qa-agent/src/call_qa_agent/schemas/call-qa.glossary.json)",
      "Edit(/apps/call-qa-agent/src/call_qa_agent/schemas/call-qa.schema.json)",
      "Edit(/ontology/schemas/workflow.schema.json)",
      "Edit(/ontology/shapes/workflow.shacl.ttl)",
      "Edit(/work/evidence/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/onto guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/onto check-terms --changed-from-stdin",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "implementer",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/onto slice --for-subagent",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/onto trace --gate stop --scope branch --collect",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/onto prov emit --scope branch",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
